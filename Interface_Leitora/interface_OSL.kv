#:kivy 1.11.1
#:import dp kivy.metrics.dp

ScreenManager:
    TelaPrincipalLeitora:
    TelaParametrosLeitura:
    TelaGraficos:


<TelaPrincipalLeitora>:
    name: "main"

    BoxLayout:
        orientation: "horizontal"
        padding: 2
        spacing: 2

        BoxLayout:
            orientation: "vertical"
            padding: 8
            spacing: 8

            Label:
                text: "OSL Reading"
                size_hint_y: None
                height: 34
                font_size: "22sp"
                bold: True

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: 8

                Spinner:
                    id: porta_spinner
                    text: "COM Port"
                    values: []

                Button:
                    text: "Refresh"
                    size_hint_x: None
                    width: "100dp"
                    on_release: app.root.get_screen("main").atualizar_portas_serial()

                Button:
                    id: botao_conexao_serial
                    text: "Connect"
                    size_hint_x: None
                    width: "110dp"
                    on_release: app.root.get_screen("main").func_botao_conexao_serial()

            BoxLayout:
                size_hint_y: None
                height: "36dp"

                TextInput:
                    id: nome_arquivo_input
                    hint_text: "File Name"

            BoxLayout:
                size_hint_y: None
                height: "36dp"

                Label:
                    text: "ECC"
                    text_size: self.size
                    font_size: "18sp"
                    halign: "center"
                    valign: "middle"

                TextInput:
                    id: ecc_textInput
                    text: "1"

            BoxLayout:
                size_hint_y: None
                height: "36dp"

                Label:
                    text: "RCF"
                    text_size: self.size
                    font_size: "18sp"
                    halign: "center"
                    valign: "middle"

                TextInput:
                    id: rcf_textInput
                    text: "0.001"

            BoxLayout:
                size_hint_y: None
                height: "36dp"

                Label:
                    text: "Fang"
                    text_size: self.size
                    font_size: "18sp"
                    halign: "center"
                    valign: "middle"

                TextInput:
                    id: fcal_textInput
                    text: "1"

            BoxLayout:
                size_hint_y: None
                height: "36dp"

                Label:
                    text: "Fenerg"
                    text_size: self.size
                    font_size: "18sp"
                    halign: "center"
                    valign: "middle"

                TextInput:
                    id: fenerg_textInput
                    text: "1"

            BoxLayout:
                size_hint_y: None
                height: "36dp"

                Label:
                    text: "Base Line"
                    text_size: self.size
                    font_size: "18sp"
                    halign: "center"
                    valign: "middle"

                TextInput:
                    id: branco_textInput
                    text: "0"

            GridLayout:



                cols: 2
                size_hint_y: None
                height: 108
                spacing: 8

                Button:
                    text: "Start"
                    on_release: app.root.get_screen("main").botao_leitura()

                Button:
                    text: "Stop"
                    on_release: app.root.get_screen("main").enviar_comando_sudo("stop")

                Button:
                    text: "Erase"
                    on_release: app.root.get_screen("main").enviar_comando_sudo("zerar")

                Button:
                    text: "Ref Light"
                    on_release: app.root.get_screen("main").botao_ref_light()

            Button:
                text: "Dose History"
                size_hint_y: None
                height: "36dp"
                on_release: app.trocar_para_graficos()

            TabbedPanel:
                do_default_tab: False

                TabbedPanelItem:
                    text: "Acquisition"

                    BoxLayout:
                        orientation: "vertical"

                        BoxLayout:
                            orientation: "horizontal"

                            Label:
                                text: "Count (0.1s)"
                            Label:
                                text: "Current (mA)"
                            Label:
                                text: "Light (mV)"
                            Label:
                                id: LabelDose
                                text: "Dose (mSv)"


                        BoxLayout:
                            orientation: "horizontal"

                            Label:
                                id: label_count
                                font_size: 40
                                text: "0"
                            Label:
                                id: label_current
                                font_size: 40
                                text: "0"
                            Label:
                                id: label_light
                                font_size: 40
                                text: "0"
                            Label:
                                id: label_dose
                                font_size: 40
                                text: "0"

                TabbedPanelItem:
                    text: "Serial Monitor"

                    BoxLayout:
                        orientation: "vertical"

                        Label:
                            id: status_label
                            text: "Conectando serial..."
                            size_hint_y: None
                            height: 32
                            text_size: self.size
                            halign: "left"
                            valign: "middle"

                        Label:
                            id: recebido_label
                            text: "Recebido: ---"
                            text_size: self.size
                            halign: "left"
                            valign: "top"



        BotaoNavegacaoParametros:
            text: ""
            size_hint_x: None
            width: "45dp"

            font_size: "22sp"
            bold: True

            background_normal: ""
            background_down: ""
            background_color: 0.18, 0.18, 0.18, 1

            color: 1, 1, 1, 1
            canvas.after:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    source: "assets/UI/angulo-direito-branco.png"
                    size: dp(18), dp(18)
                    pos: self.center_x - dp(9), self.center_y - dp(9)

            on_release: app.root.current = "parametros"

<TelaParametrosLeitura>:
    name: "parametros"

    BoxLayout:
        orientation: "vertical"
        padding: 12
        spacing: 12

        Label:
            text: "Setup"
            size_hint_y: None
            height: 40
            font_size: "22sp"
            bold: True

        GridLayout:
            cols: 2
            spacing: 8
            row_default_height: 42
            row_force_default: True
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "Stimulation Mode"
            Spinner:
                id: modo_input
                text: "1"
                values: ("1", "2")

            Label:
                text: "Photomultiplier Gain"
            Spinner:
                id: ganho_input
                text: "3"
                values: ("1", "2", "3", "4")

            Label:
                text: "Read Time"
            Spinner:
                id: tempo_leitura_input
                text: "03000"
                values: ("01000","02000","03000","05000","10000","30000","60000")

            Label:
                text: "Stimulation Intensity"
            Spinner:
                id: potencia_input
                text: "4"
                values: ("1", "2", "3", "4")

            Label:
                text: "Erase Time"
            Spinner:
                id: tempo_zeramento_input
                text: "05000"
                values: ("01000","02000","03000","05000","10000","30000","60000")

            Label:
                text: "Erase Intensity"
            Spinner:
                id: potencia_zeramento_input
                text: "2"
                values: ("1", "2", "3", "4")

        Button:
            text: "Update"
            size_hint_y: None
            height: 48
            on_release: app.root.get_screen("main").enviar_parametros()

        Button:
            text: "Return"
            size_hint_y: None
            height: 48
            on_release: app.root.current = "main"

        Widget:


<TelaGraficos>:
    name: "graficos"

    BoxLayout:
        orientation: "horizontal"
        padding: 8
        spacing: 8

        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.4
            spacing: 8

            FileChooserListView:
                id: seletor_arquivo
                filters: ["*.txt", "*.csv"]
                on_selection: app.root.get_screen("graficos").selecionar_arquivo(self.selection)

        BoxLayout:
            orientation: "vertical"
            spacing: 8

            Label:
                text: "Dose History"
                size_hint_y: None
                height: 30
                font_size: "22sp"
                bold: True

            BoxLayout:
                orientation: "horizontal"
                spacing: 5
                size_hint_y: None
                height: 45

                CheckBox:
                    id: cb_leitura
                    active: True
                    size_hint: None, None
                    size: 30, 30

                Label:
                    text: "Count (0.1s)"
                    size_hint_x: None
                    width: self.texture_size[0]

                CheckBox:
                    id: cb_corrente
                    active: True
                    size_hint: None, None
                    size: 30, 30

                Label:
                    text: "Current (mA)"
                    size_hint_x: None
                    width: self.texture_size[0]

                CheckBox:
                    id: cb_luz
                    active: True
                    size_hint: None, None
                    size: 30, 30

                Label:
                    text: "Light (mV)"
                    size_hint_x: None
                    width: self.texture_size[0]

            Image:
                id: imagem_grafico
                source: ""

            BoxLayout:
                size_hint_y: None
                height: "44dp"
                spacing: 8

                Button:
                    text: "Plot"
                    on_release: app.root.get_screen("graficos").gerar_grafico()

                Button:
                    text: "Export CSV"
                    on_release: app.root.get_screen("graficos").exportar_csv()

            Label:
                id: status_grafico_label
                text: "Select the log file."
                size_hint_y: None
                height: 32
                text_size: self.size
                halign: "left"
                valign: "middle"

            Button:
                text: "Return"
                size_hint_y: None
                height: 44
                on_release: app.root.current = "main"
