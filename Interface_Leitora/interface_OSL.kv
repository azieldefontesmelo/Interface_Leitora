#:kivy 1.11.1
#:import dp kivy.metrics.dp
#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import Window kivy.core.window.Window

<BotaoBarraLateral@Button>:
    selecionado: False
    size_hint: None, None
    size: "55dp", "50dp"
    text: ""
    background_normal: ""
    background_down: ""
    background_color: (0.22, 0.22, 0.22, 1) if self.selecionado else (0.10, 0.10, 0.10, 1)

    canvas.before:
        Color:
            rgba: (0.82, 0.82, 0.82, 1) if self.selecionado else (0, 0, 0, 0)
        Rectangle:
            pos: self.x, self.y + dp(8)
            size: dp(3), self.height - dp(16)


<BarraLateral@BoxLayout>:
    tela_ativa: ""
    orientation: "vertical"
    size_hint: None, 1
    width: "56dp"
    spacing: 2

    canvas.before:
        Color:
            rgba: 0.10, 0.10, 0.10, 1
        Rectangle:
            pos: self.pos
            size: self.size
    canvas.after:
        Color:
            rgba: 0.28, 0.28, 0.28, 1
        Line:
            points: self.right, self.y, self.right, self.top
            width: 1

    Widget:
        size_hint_y: None
        height: "8dp"

    BotaoBarraLateral:
        selecionado: root.tela_ativa == "main"
        on_release: app.root.current = "main"

        canvas.after:
            Color:
                rgba: (0.95, 0.95, 0.95, 1) if self.selecionado else (0.62, 0.62, 0.62, 1)
            Rectangle:
                source: "assets/UI/sidebar/radiation.png"
                size: dp(34), dp(34)
                pos: self.center_x - dp(17), self.center_y - dp(17)

    BotaoBarraLateral:
        selecionado: root.tela_ativa == "banco_dados"
        on_release: app.root.current = "banco_dados"

        canvas.after:
            Color:
                rgba: (0.95, 0.95, 0.95, 1) if self.selecionado else (0.62, 0.62, 0.62, 1)
            Rectangle:
                source: "assets/UI/sidebar/database.png"
                size: dp(34), dp(34)
                pos: self.center_x - dp(17), self.center_y - dp(17)

    BotaoBarraLateral:
        selecionado: root.tela_ativa == "graficos"
        on_release: app.root.current = "graficos"

        canvas.after:
            Color:
                rgba: (0.95, 0.95, 0.95, 1) if self.selecionado else (0.62, 0.62, 0.62, 1)
            Rectangle:
                source: "assets/UI/sidebar/chart-no-axes-combined.png"
                size: dp(34), dp(34)
                pos: self.center_x - dp(17), self.center_y - dp(17)

    BotaoBarraLateral:
        selecionado: root.tela_ativa == "parametros"
        on_release: app.root.current = "parametros"

        canvas.after:
            Color:
                rgba: (0.95, 0.95, 0.95, 1) if self.selecionado else (0.62, 0.62, 0.62, 1)
            Rectangle:
                source: "assets/UI/sidebar/sliders-horizontal.png"
                size: dp(34), dp(34)
                pos: self.center_x - dp(17), self.center_y - dp(17)

    Widget:

    BotaoBarraLateral:
        canvas.after:
            Color:
                rgba: 0.62, 0.62, 0.62, 1
            Rectangle:
                source: "assets/UI/sidebar/info.png"
                size: dp(30), dp(30)
                pos: self.center_x - dp(15), self.center_y - dp(15)

    Widget:
        size_hint_y: None
        height: "8dp"


<PainelBanco@BoxLayout>:
    padding: "14dp"
    spacing: "10dp"

    canvas.before:
        Color:
            rgba: 0.13, 0.13, 0.13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(7)]
    canvas.after:
        Color:
            rgba: 0.28, 0.28, 0.28, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(7))
            width: 1


<CabecalhoTabelaBanco@Label>:
    bold: True
    font_size: "12sp"
    color: 0.76, 0.76, 0.76, 1
    text_size: self.size
    halign: "left"
    valign: "middle"


<CelulaTabelaBanco@Label>:
    font_size: "12sp"
    color: 0.90, 0.90, 0.90, 1
    text_size: self.size
    halign: "left"
    valign: "middle"


ScreenManager:
    size: Window.size
    pos: 0, 0
    transition: NoTransition()
    TelaPrincipalLeitora:
        size: root.size
        pos: root.pos
    TelaParametrosLeitura:
        size: root.size
        pos: root.pos
    TelaGraficos:
        size: root.size
        pos: root.pos
    TelaBancoDados:
        size: root.size
        pos: root.pos


<TelaPrincipalLeitora>:
    name: "main"

    ScrollView:
        id: rolagem_principal
        size_hint: None, None
        size: root.width - dp(56), root.height
        pos: root.x + dp(56), root.y
        do_scroll_x: False
        do_scroll_y: True
        # Em Kivy, scroll_y = 1 posiciona o topo do conteúdo no viewport.
        scroll_y: 1
        scroll_type: ["bars", "content"]
        bar_width: "10dp"
        bar_color: 0.55, 0.55, 0.55, 1
        bar_inactive_color: 0.28, 0.28, 0.28, 0.8

        BoxLayout:
            id: conteudo_principal
            orientation: "vertical"
            size_hint_y: None
            # Inclui a altura mínima real dos filhos para não recortar os
            # controles superiores em telas com pouca altura.
            height: max(dp(700), self.minimum_height, root.height)
            padding: 8
            spacing: 8

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: 6

                Label:
                    text: "OSL Reading"
                    font_size: "22sp"
                    bold: True

            BoxLayout:
                size_hint_y: None
                height: "72dp"
                spacing: 12
                padding: 8, 5

                canvas.before:
                    Color:
                        rgba: 0.12, 0.12, 0.12, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(6)]
                canvas.after:
                    Color:
                        rgba: 0.24, 0.24, 0.24, 1
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(6))
                        width: 1

                BoxLayout:
                    orientation: "vertical"
                    spacing: 4

                    Label:
                        text: "Porta COM"
                        size_hint_y: None
                        height: "16dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"
                        font_size: "12sp"
                        bold: True

                    BoxLayout:
                        spacing: 8

                        Spinner:
                            id: porta_spinner
                            text: "COM Port"
                            values: []

                        Button:
                            text: "Refresh"
                            size_hint_x: None
                            width: "106dp"
                            on_release: app.root.get_screen("main").atualizar_portas_serial()

                        Button:
                            id: botao_conexao_serial
                            text: "Connect"
                            size_hint_x: None
                            width: "106dp"
                            on_release: app.root.get_screen("main").func_botao_conexao_serial()

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: None
                    width: "220dp"
                    spacing: 4

                    Label:
                        text: "Controle"
                        size_hint_y: None
                        height: "16dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"
                        font_size: "12sp"
                        bold: True

                    BoxLayout:
                        spacing: 8

                        Button:
                            id: start_button
                            text: "Start"
                            size_hint_x: None
                            width: "106dp"
                            disabled: root.test_mode == "DOSIMETER_ID" and not root.start_allowed
                            on_release: app.root.get_screen("main").botao_leitura()

                        Button:
                            text: "Stop"
                            size_hint_x: None
                            width: "106dp"
                            on_release: app.root.get_screen("main").botao_stop()

            BoxLayout:
                size_hint_y: None
                height: "42dp"
                spacing: 0

                Button:
                    text: "Manual"
                    background_normal: ""
                    background_down: ""
                    background_color: 0.16, 0.16, 0.16, 1
                    on_release: root.selecionar_modo("MANUAL")

                    canvas.after:
                        Color:
                            rgba: (0.08, 0.55, 0.95, 1) if root.test_mode == "MANUAL" else (0.32, 0.32, 0.32, 1)
                        Rectangle:
                            pos: self.x, self.y
                            size: self.width, dp(3)

                Button:
                    text: "Dosímetro ID"
                    background_normal: ""
                    background_down: ""
                    background_color: 0.16, 0.16, 0.16, 1
                    on_release: root.selecionar_modo("DOSIMETER_ID")

                    canvas.after:
                        Color:
                            rgba: (0.08, 0.55, 0.95, 1) if root.test_mode == "DOSIMETER_ID" else (0.32, 0.32, 0.32, 1)
                        Rectangle:
                            pos: self.x, self.y
                            size: self.width, dp(3)

            GridLayout:
                id: manual_panel
                cols: 2
                size_hint_y: None
                height: dp(216) if root.test_mode == "MANUAL" else 0
                opacity: 1 if root.test_mode == "MANUAL" else 0
                disabled: root.test_mode != "MANUAL"
                spacing: 6

                Label:
                    text: "ECC"
                    font_size: "18sp"
                TextInput:
                    id: ecc_textInput
                    text: "1"
                    multiline: False

                Label:
                    text: "RCF"
                    font_size: "18sp"
                TextInput:
                    id: rcf_textInput
                    text: "0.000033"
                    multiline: False

                Label:
                    text: "Fang"
                    font_size: "18sp"
                TextInput:
                    id: fcal_textInput
                    text: "1"
                    multiline: False

                Label:
                    text: "Fenerg"
                    font_size: "18sp"
                TextInput:
                    id: fenerg_textInput
                    text: "1"
                    multiline: False

                Label:
                    text: "Base Line"
                    font_size: "18sp"
                TextInput:
                    id: branco_textInput
                    text: "0"
                    multiline: False

                Label:
                    text: "File Name"
                    font_size: "18sp"
                TextInput:
                    id: nome_arquivo_input
                    hint_text: "File Name"
                    multiline: False

            BoxLayout:
                id: dosimeter_panel
                orientation: "vertical"
                size_hint_y: None
                height: dp(226) if root.test_mode == "DOSIMETER_ID" else 0
                opacity: 1 if root.test_mode == "DOSIMETER_ID" else 0
                disabled: root.test_mode != "DOSIMETER_ID"
                spacing: 6

                BoxLayout:
                    size_hint_y: None
                    height: "50dp"
                    spacing: 8

                    BoxLayout:
                        orientation: "vertical"

                        Label:
                            text: "Dosímetro ID"
                            size_hint_y: None
                            height: "18dp"
                            text_size: self.size
                            halign: "left"
                            valign: "middle"

                        TextInput:
                            id: dosimeter_id_input
                            hint_text: "Leia os 10 dígitos e pressione Enter"
                            multiline: False
                            disabled: root.test_session_active
                            on_text: root.dosimetro_texto_alterado(self.text)
                            on_text_validate: root.confirmar_codigo_dosimetro()

                    BoxLayout:
                        orientation: "vertical"

                        Label:
                            text: "Leitora"
                            size_hint_y: None
                            height: "18dp"
                            text_size: self.size
                            halign: "left"
                            valign: "middle"

                        Spinner:
                            id: reader_spinner
                            text: "Selecione a leitora"
                            values: []
                            disabled: root.test_session_active
                            on_text: root.leitora_selecionada(self.text)

                BoxLayout:
                    size_hint_y: None
                    height: "42dp"
                    spacing: 8

                    Label:
                        text: "Grandeza"
                        size_hint_x: None
                        width: "100dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"

                    Button:
                        id: hp10_button
                        text: "Lendo Hp(10)..." if root.acquisition_active and root.dose_channel == "HP10" else ("Hp(10) concluído  ✓" if root.hp10_complete else "Hp(10)")
                        background_normal: ""
                        background_down: ""
                        background_color: (0.08, 0.55, 0.95, 1) if root.dose_channel == "HP10" else (0.16, 0.16, 0.16, 1)
                        disabled: root.acquisition_active or root.hp10_complete or (root.test_session_active and root.dose_channel != "HP10")
                        on_release: root.selecionar_grandeza("HP10")

                    Button:
                        id: hp007_button
                        text: "Lendo Hp(0,07)..." if root.acquisition_active and root.dose_channel == "HP007" else ("Hp(0,07) concluído  ✓" if root.hp007_complete else "Hp(0,07)")
                        background_normal: ""
                        background_down: ""
                        background_color: (0.08, 0.55, 0.95, 1) if root.dose_channel == "HP007" else (0.16, 0.16, 0.16, 1)
                        disabled: root.acquisition_active or root.hp007_complete or (root.test_session_active and root.dose_channel != "HP007")
                        on_release: root.selecionar_grandeza("HP007")

                Label:
                    text: root.dosimeter_status
                    size_hint_y: None
                    height: "32dp"
                    text_size: self.size
                    halign: "left"
                    valign: "middle"
                    color: (0.42, 0.86, 0.48, 1) if root.start_allowed else (0.92, 0.72, 0.35, 1)

                Label:
                    text: "ECC: {}   •   BC: {}   •   RCF: {}   •   Arquivo: {}".format(root.loaded_ecc, root.loaded_bc, root.loaded_rcf, root.automatic_file_name)
                    size_hint_y: None
                    height: "32dp"
                    text_size: self.size
                    halign: "left"
                    valign: "middle"

                Label:
                    text: "ECC e BC são carregados do cadastro conforme a grandeza selecionada."
                    size_hint_y: None
                    height: "28dp"
                    color: 0.68, 0.68, 0.68, 1
                    text_size: self.size
                    halign: "left"
                    valign: "middle"

            GridLayout:
                cols: 2
                size_hint_y: None
                height: "52dp"
                spacing: 8

                Button:
                    text: "Erase"
                    on_release: app.root.get_screen("main").botao_apagar()

                Button:
                    text: "Ref Light"
                    on_release: app.root.get_screen("main").botao_ref_light()

            TabbedPanel:
                do_default_tab: False
                size_hint_y: 1
                # Garante uma area minima legivel para as abas, inclusive
                # em telas com pouca altura; a tela principal continua
                # rolavel quando a janela for menor que esse tamanho.
                size_hint_min_y: "300dp"
                tab_height: "40dp"

                TabbedPanelItem:
                    text: "Acquisition"

                    BoxLayout:
                        orientation: "vertical"
                        padding: 4

                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "32dp"
                            spacing: 4

                            Label:
                                text: "Count (0.1s)"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                            Label:
                                text: "Current (mA)"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                            Label:
                                text: "Light (mV)"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                            Label:
                                id: LabelDose
                                text: "Dose (mSv)"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"


                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_y: 1
                            spacing: 4

                            Label:
                                id: label_count
                                font_size: "32sp"
                                text: "0"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                            Label:
                                id: label_current
                                font_size: "32sp"
                                text: "0"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                            Label:
                                id: label_light
                                font_size: "32sp"
                                text: "0"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                            Label:
                                id: label_dose
                                font_size: "32sp"
                                text: "0"
                                text_size: self.size
                                halign: "center"
                                valign: "middle"

                TabbedPanelItem:
                    text: "Graphics"

                    BoxLayout:
                        orientation: "vertical"
                        padding: 4
                        spacing: 4

                        BoxLayout:
                            size_hint_y: None
                            height: "36dp"
                            spacing: 18

                            BoxLayout:
                                size_hint_x: None
                                width: "130dp"

                                CheckBox:
                                    id: cb_tempo_count
                                    active: True
                                    size_hint_x: None
                                    width: "32dp"
                                    on_active: root.ids.grafico_tempo_real.definir_serie("count", self.active)

                                Label:
                                    text: "Count (0.1s)"
                                    color: 0.2, 0.7, 1, 1
                                    text_size: self.size
                                    halign: "left"
                                    valign: "middle"

                            BoxLayout:
                                size_hint_x: None
                                width: "130dp"

                                CheckBox:
                                    id: cb_tempo_current
                                    active: True
                                    size_hint_x: None
                                    width: "32dp"
                                    on_active: root.ids.grafico_tempo_real.definir_serie("current", self.active)

                                Label:
                                    text: "Current (mA)"
                                    color: 1, 0.65, 0.2, 1
                                    text_size: self.size
                                    halign: "left"
                                    valign: "middle"

                            BoxLayout:
                                size_hint_x: None
                                width: "120dp"

                                CheckBox:
                                    id: cb_tempo_light
                                    active: True
                                    size_hint_x: None
                                    width: "32dp"
                                    on_active: root.ids.grafico_tempo_real.definir_serie("light", self.active)

                                Label:
                                    text: "Light (mV)"
                                    color: 0.35, 0.9, 0.4, 1
                                    text_size: self.size
                                    halign: "left"
                                    valign: "middle"

                            Widget:

                            Button:
                                text: "Limpar"
                                size_hint_x: None
                                width: "90dp"
                                on_release: app.root.get_screen("main").ids.grafico_tempo_real.limpar()

                            Button:
                                text: "Dose History"
                                size_hint_x: None
                                width: "120dp"
                                background_normal: ""
                                background_down: ""
                                background_color: 0, 0, 0, 0

                                canvas.before:
                                    Color:
                                        rgba: (0.08, 0.42, 0.85, 1) if self.state == "down" else (0.35, 0.35, 0.35, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(3)]

                                on_release: app.root.current = "graficos"

                        GraficoTempoReal:
                            id: grafico_tempo_real

                TabbedPanelItem:
                    text: "Serial Monitor"

                    BoxLayout:
                        orientation: "vertical"

                        Label:
                            id: status_label
                            text: "Conectando serial..."
                            size_hint_y: None
                            height: 32
                            text_size: self.size
                            halign: "left"
                            valign: "middle"

                        Label:
                            id: recebido_label
                            text: "Recebido: ---"
                            text_size: self.size
                            halign: "left"
                            valign: "top"

    BarraLateral:
        tela_ativa: "main"
        pos: root.pos


<TelaParametrosLeitura>:
    name: "parametros"

    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint: None, None
        size: root.width - dp(56), root.height
        pos: root.x + dp(56), root.y
        padding: 12
        spacing: 12

        BoxLayout:
            size_hint_y: None
            height: "40dp"
            spacing: 6

            Label:
                text: "Setup"
                font_size: "22sp"
                bold: True

        GridLayout:
            cols: 2
            spacing: 8
            row_default_height: 42
            row_force_default: True
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "Stimulation Mode"
            Spinner:
                id: modo_input
                text: "1"
                values: ("1", "2")

            Label:
                text: "Photomultiplier Gain"
            Spinner:
                id: ganho_input
                text: "4"
                values: ("1", "2", "3", "4")

            Label:
                text: "Read Time"
            Spinner:
                id: tempo_leitura_input
                text: "03000"
                values: ("01000","02000","03000","05000","10000","30000","60000")

            Label:
                text: "Stimulation Intensity"
            Spinner:
                id: potencia_input
                text: "4"
                values: ("1", "2", "3", "4")

            Label:
                text: "Erase Time"
            Spinner:
                id: tempo_zeramento_input
                text: "05000"
                values: ("01000","02000","03000","05000","10000","30000","60000")

            Label:
                text: "Erase Intensity"
            Spinner:
                id: potencia_zeramento_input
                text: "2"
                values: ("1", "2", "3", "4")

        Button:
            text: "Update"
            size_hint_y: None
            height: 48
            on_release: app.root.get_screen("main").enviar_parametros()

        Widget:

    BarraLateral:
        tela_ativa: "parametros"
        pos: root.pos


<TelaGraficos>:
    name: "graficos"

    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "horizontal"
        size_hint: None, None
        size: root.width - dp(56), root.height
        pos: root.x + dp(56), root.y
        padding: 8
        spacing: 8

        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.32
            spacing: 8

            Label:
                text: "Pastas e arquivos de teste"
                size_hint_y: None
                height: "32dp"
                font_size: "16sp"
                bold: True
                text_size: self.size
                halign: "left"
                valign: "middle"

            ScrollView:
                id: rolagem_arvore
                do_scroll_x: False
                do_scroll_y: True
                scroll_type: ["bars", "content"]
                bar_width: "8dp"
                bar_color: 0.55, 0.55, 0.55, 1
                bar_inactive_color: 0.28, 0.28, 0.28, 0.8

                ArvoreArquivos:
                    id: arvore_arquivos
                    size_hint_y: None
                    height: self.altura_conteudo

            Label:
                text: "Filtrar por data"
                size_hint_y: None
                height: "24dp"
                text_size: self.size
                halign: "left"
                valign: "middle"

            BoxLayout:
                size_hint_y: None
                height: "40dp"
                spacing: 6

                EntradaData:
                    id: data_filtro
                    hint_text: "dd/mm/aaaa"
                    multiline: False
                    write_tab: False
                    on_text_validate: app.root.get_screen("graficos").filtrar_por_data()

                Button:
                    text: "Filtrar"
                    size_hint_x: None
                    width: "78dp"
                    on_release: app.root.get_screen("graficos").filtrar_por_data()

                Button:
                    text: "Limpar"
                    size_hint_x: None
                    width: "70dp"
                    on_release: app.root.get_screen("graficos").limpar_filtro_data()

        BoxLayout:
            orientation: "vertical"
            spacing: 8

            Label:
                text: "Dose History"
                size_hint_y: None
                height: 30
                font_size: "22sp"
                bold: True

            BoxLayout:
                orientation: "horizontal"
                spacing: 5
                size_hint_y: None
                height: 45

                CheckBox:
                    id: cb_leitura
                    active: True
                    size_hint: None, None
                    size: 30, 30

                Label:
                    text: "Count (0.1s)"
                    size_hint_x: None
                    width: self.texture_size[0]

                CheckBox:
                    id: cb_corrente
                    active: True
                    size_hint: None, None
                    size: 30, 30

                Label:
                    text: "Current (mA)"
                    size_hint_x: None
                    width: self.texture_size[0]

                CheckBox:
                    id: cb_luz
                    active: True
                    size_hint: None, None
                    size: 30, 30

                Label:
                    text: "Light (mV)"
                    size_hint_x: None
                    width: self.texture_size[0]

            Image:
                id: imagem_grafico
                source: ""

            BoxLayout:
                size_hint_y: None
                height: "44dp"
                spacing: 8

                Button:
                    id: botao_plot
                    text: "Plot"
                    on_release: app.root.get_screen("graficos").gerar_grafico()

                Button:
                    id: botao_exportar_csv
                    text: "Export CSV"
                    on_release: app.root.get_screen("graficos").exportar_csv()

            Label:
                id: status_grafico_label
                text: "Select the log file."
                size_hint_y: None
                height: 32
                text_size: self.size
                halign: "left"
                valign: "middle"

            Button:
                text: "Return"
                size_hint_y: None
                height: 44
                on_release: app.root.current = "main"

    BarraLateral:
        tela_ativa: "graficos"
        pos: root.pos


<TelaBancoDados>:
    name: "banco_dados"

    canvas.before:
        Color:
            rgba: 0.075, 0.075, 0.075, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint: None, None
        size: root.width - dp(56), root.height
        pos: root.x + dp(56), root.y
        padding: "16dp"
        spacing: "10dp"

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "58dp"

            Label:
                text: "Banco de dados"
                font_size: "24sp"
                bold: True
                text_size: self.size
                halign: "left"
                valign: "middle"

            Label:
                text: "Cadastros, histórico de leituras, CSV, backup e importação SQLite"
                font_size: "13sp"
                color: 0.65, 0.65, 0.65, 1
                text_size: self.size
                halign: "left"
                valign: "top"

        TabbedPanel:
            id: database_tabs
            do_default_tab: False
            tab_height: "40dp"
            tab_width: self.width / 5

            TabbedPanelItem:
                text: "Integral da Área"

                BoxLayout:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "8dp"

                    GridLayout:
                        cols: 3
                        size_hint_y: None
                        height: "66dp"
                        spacing: "8dp"

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Dosimeter"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_personal_dose_dosimeter
                                multiline: False
                                on_text_validate: root.pesquisar_doses_pessoais()

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Initial date"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_personal_dose_from
                                hint_text: "dd/mm/aaaa"
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Final date (optional)"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_personal_dose_to
                                hint_text: "opcional"
                                multiline: False

                    BoxLayout:
                        size_hint_y: None
                        height: "36dp"

                        canvas.before:
                            Color:
                                rgba: 0.09, 0.10, 0.12, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Data/hora"
                            size_hint_x: 0.25
                            bold: True
                            text_size: self.size
                            halign: "left"
                            valign: "middle"
                            padding: "10dp", 0

                        Label:
                            text: "Dosímetro"
                            size_hint_x: 0.20
                            bold: True

                        Label:
                            text: "Hp(10) mSv"
                            size_hint_x: 0.17
                            bold: True

                        Label:
                            text: "Hp(0,07) mSv"
                            size_hint_x: 0.17
                            bold: True

                        Label:
                            text: "Status  •  " + root.personal_dose_count
                            size_hint_x: 0.21
                            bold: True

                    ScrollView:
                        do_scroll_x: False

                        GridLayout:
                            id: db_personal_dose_results
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "3dp"

                    BoxLayout:
                        size_hint_y: None
                        height: "40dp"
                        spacing: "8dp"

                        Button:
                            text: "Search"
                            on_release: root.pesquisar_doses_pessoais()
                        Button:
                            text: "Export CSV"
                            on_release: root.exportar_csv_doses_pessoais()

                    Label:
                        text: root.personal_dose_message
                        size_hint_y: None
                        height: "30dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"

            TabbedPanelItem:
                text: "Linha de Base"

                BoxLayout:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "8dp"

                    GridLayout:
                        cols: 3
                        size_hint_y: None
                        height: "66dp"
                        spacing: "8dp"

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Dosimeter"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_background_dosimeter
                                multiline: False
                                on_text_validate: root.pesquisar_backgrounds()

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Initial date"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_background_from
                                hint_text: "dd/mm/aaaa"
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Final date (optional)"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_background_to
                                hint_text: "opcional"
                                multiline: False

                    BoxLayout:
                        size_hint_y: None
                        height: "36dp"

                        canvas.before:
                            Color:
                                rgba: 0.09, 0.10, 0.12, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Data/hora"
                            size_hint_x: 0.25
                            bold: True
                            text_size: self.size
                            halign: "left"
                            valign: "middle"
                            padding: "10dp", 0

                        Label:
                            text: "Dosímetro"
                            size_hint_x: 0.20
                            bold: True

                        Label:
                            text: "Hp(10) mSv"
                            size_hint_x: 0.17
                            bold: True

                        Label:
                            text: "Hp(0,07) mSv"
                            size_hint_x: 0.17
                            bold: True

                        Label:
                            text: "Status  •  " + root.background_count
                            size_hint_x: 0.21
                            bold: True

                    ScrollView:
                        do_scroll_x: False

                        GridLayout:
                            id: db_background_results
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "3dp"

                    BoxLayout:
                        size_hint_y: None
                        height: "40dp"
                        spacing: "8dp"

                        Button:
                            text: "Search"
                            on_release: root.pesquisar_backgrounds()
                        Button:
                            text: "Export CSV"
                            on_release: root.exportar_csv_backgrounds()

                    Label:
                        text: root.background_message
                        size_hint_y: None
                        height: "30dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"

            TabbedPanelItem:
                text: "Dosímetros"

                BoxLayout:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "8dp"

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        TextInput:
                            id: db_dosimeter_search
                            hint_text: "Pesquisar por Dosímetro ID"
                            multiline: False
                            on_text_validate: root.pesquisar_dosimetros()

                        Button:
                            text: "Pesquisar"
                            size_hint_x: None
                            width: "110dp"
                            on_release: root.pesquisar_dosimetros()

                    GridLayout:
                        cols: 4
                        size_hint_y: None
                        height: "132dp"
                        spacing: "8dp"

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Dosímetro ID"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_dosimeter_id
                                multiline: False
                                on_text_validate: root.carregar_dosimetro_por_id(self.text)
                                on_focus:
                                    if not self.focus: root.carregar_dosimetro_por_id(self.text)

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "ECC Hp(10)"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_dosimeter_ecc_hp10
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "ECC Hp(0,07)"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_dosimeter_ecc_hp007
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Ativo"
                                size_hint_y: None
                                height: "22dp"
                            CheckBox:
                                id: db_dosimeter_active
                                active: True

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "BC Hp(10)"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_dosimeter_bc_hp10
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "BC Hp(0,07)"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_dosimeter_bc_hp007
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Data inicial"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_dosimeter_begin
                                hint_text: "dd/mm/aaaa"
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Data final (opcional)"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_dosimeter_end
                                hint_text: "opcional"
                                multiline: False

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        Button:
                            text: "Novo"
                            on_release: root.novo_dosimetro()
                        Button:
                            text: "Salvar"
                            on_release: root.salvar_dosimetro()
                        Button:
                            text: "Ativar/Desativar"
                            on_release: root.alternar_dosimetro()
                        Button:
                            text: "Excluir"
                            on_release: root.excluir_dosimetro()

                    BoxLayout:
                        size_hint_y: None
                        height: "36dp"

                        canvas.before:
                            Color:
                                rgba: 0.09, 0.10, 0.12, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Dosímetro"
                            size_hint_x: 0.17
                            bold: True
                            text_size: self.size
                            halign: "left"
                            valign: "middle"
                            padding: "10dp", 0
                        Label:
                            text: "ECC Hp(10)"
                            size_hint_x: 0.11
                            bold: True
                        Label:
                            text: "ECC Hp(0,07)"
                            size_hint_x: 0.12
                            bold: True
                        Label:
                            text: "BC Hp(10)"
                            size_hint_x: 0.10
                            bold: True
                        Label:
                            text: "BC Hp(0,07)"
                            size_hint_x: 0.11
                            bold: True
                        Label:
                            text: "Data inicial"
                            size_hint_x: 0.14
                            bold: True
                        Label:
                            text: "Data final"
                            size_hint_x: 0.14
                            bold: True
                        Label:
                            text: "Status  •  " + root.dosimeter_count
                            size_hint_x: 0.11
                            bold: True

                    ScrollView:
                        do_scroll_x: False

                        GridLayout:
                            id: db_dosimeter_results
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "3dp"

                    Label:
                        text: root.dosimeter_message
                        size_hint_y: None
                        height: "30dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"

            TabbedPanelItem:
                text: "Leitoras"

                BoxLayout:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "8dp"

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        TextInput:
                            id: db_reader_search
                            hint_text: "Pesquisar por Reader"
                            multiline: False
                            on_text_validate: root.pesquisar_leitoras()

                        Button:
                            text: "Pesquisar"
                            size_hint_x: None
                            width: "110dp"
                            on_release: root.pesquisar_leitoras()

                    GridLayout:
                        cols: 5
                        size_hint_y: None
                        height: "70dp"
                        spacing: "8dp"

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Reader"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_reader_id
                                multiline: False
                                on_text_validate: root.carregar_leitora_por_id(self.text)
                                on_focus:
                                    if not self.focus: root.carregar_leitora_por_id(self.text)

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "RCF"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_reader_rcf
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Begin Date"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_reader_begin
                                hint_text: "dd/mm/aaaa"
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "End Date (optional)"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_reader_end
                                hint_text: "opcional"
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Active"
                                size_hint_y: None
                                height: "22dp"
                            CheckBox:
                                id: db_reader_active
                                active: True

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        Button:
                            text: "Nova"
                            on_release: root.nova_leitora()
                        Button:
                            text: "Salvar"
                            on_release: root.salvar_leitora()
                        Button:
                            text: "Ativar/Desativar"
                            on_release: root.alternar_leitora()
                        Button:
                            text: "Excluir"
                            on_release: root.excluir_leitora()

                    BoxLayout:
                        size_hint_y: None
                        height: "36dp"

                        canvas.before:
                            Color:
                                rgba: 0.09, 0.10, 0.12, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Leitora"
                            size_hint_x: 0.25
                            bold: True
                            text_size: self.size
                            halign: "left"
                            valign: "middle"
                            padding: "10dp", 0
                        Label:
                            text: "RCF"
                            size_hint_x: 0.12
                            bold: True
                        Label:
                            text: "Data inicial"
                            size_hint_x: 0.20
                            bold: True
                        Label:
                            text: "Data final"
                            size_hint_x: 0.20
                            bold: True
                        Label:
                            text: "Status  •  " + root.reader_count
                            size_hint_x: 0.23
                            bold: True

                    ScrollView:
                        do_scroll_x: False

                        GridLayout:
                            id: db_reader_results
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "3dp"

                    Label:
                        text: root.reader_message
                        size_hint_y: None
                        height: "30dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"

            TabbedPanelItem:
                text: "Histórico"

                BoxLayout:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "8dp"

                    GridLayout:
                        cols: 5
                        size_hint_y: None
                        height: "66dp"
                        spacing: "8dp"

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Dosímetro"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_history_dosimeter
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Leitora"
                                size_hint_y: None
                                height: "22dp"
                            TextInput:
                                id: db_history_reader
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Modo"
                                size_hint_y: None
                                height: "22dp"
                            Spinner:
                                id: db_history_mode
                                text: "Todos"
                                values: ("Todos", "MANUAL", "DOSIMETER_ID")

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Data inicial"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_history_from
                                hint_text: "dd/mm/aaaa"
                                multiline: False

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: "Data final (opcional)"
                                size_hint_y: None
                                height: "22dp"
                            EntradaData:
                                id: db_history_to
                                hint_text: "opcional"
                                multiline: False

                    BoxLayout:
                        size_hint_y: None
                        height: "36dp"

                        canvas.before:
                            Color:
                                rgba: 0.09, 0.10, 0.12, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Data/hora"
                            size_hint_x: 0.20
                            bold: True
                            text_size: self.size
                            halign: "left"
                            valign: "middle"
                            padding: "10dp", 0

                        Label:
                            text: "Dosímetro"
                            size_hint_x: 0.14
                            bold: True
                        Label:
                            text: "Leitora"
                            size_hint_x: 0.12
                            bold: True
                        Label:
                            text: "Modo"
                            size_hint_x: 0.13
                            bold: True
                        Label:
                            text: "Grandeza"
                            size_hint_x: 0.11
                            bold: True
                        Label:
                            text: "Dose (mSv)"
                            size_hint_x: 0.12
                            bold: True
                        Label:
                            text: "Status  •  " + root.history_count
                            size_hint_x: 0.18
                            bold: True

                    ScrollView:
                        do_scroll_x: False

                        GridLayout:
                            id: db_history_results
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "3dp"

                    Label:
                        text: root.history_details
                        size_hint_y: None
                        height: "104dp"
                        font_size: "12sp"
                        text_size: self.size
                        halign: "left"
                        valign: "top"

                    BoxLayout:
                        size_hint_y: None
                        height: "40dp"
                        spacing: "8dp"

                        Button:
                            text: "Pesquisar"
                            on_release: root.pesquisar_historico()
                        Button:
                            text: "Exportar CSV"
                            on_release: root.exportar_csv_historico()
                        Button:
                            text: "Exportar backup do banco"
                            on_release: root.abrir_dialogo_backup()
                        Button:
                            text: "Importar banco"
                            on_release: root.abrir_dialogo_importacao()

                    Label:
                        text: root.history_message
                        size_hint_y: None
                        height: "30dp"
                        text_size: self.size
                        halign: "left"
                        valign: "middle"

    BarraLateral:
        tela_ativa: "banco_dados"
        pos: root.pos
